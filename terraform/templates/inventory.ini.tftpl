# Сгенерировано Terraform. Не редактируй вручную.
[all:vars]
ansible_user=hex
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[kube_control_plane]
%{ for node in control_planes ~}
${node.name} ansible_host=${node.ip}
%{ endfor ~}

[etcd]
%{ for node in control_planes ~}
${node.name} ansible_host=${node.ip}
%{ endfor ~}

[kube_node]
%{ for node in workers ~}
${node.name} ansible_host=${node.ip}
%{ endfor ~}
